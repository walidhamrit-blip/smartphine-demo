# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required in production.
# The app creates its own tables and seeds the demo catalog on the first
# request, so an empty database is enough.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Password of the /admin console. Change it before going live.
ADMIN_PASSWORD=myphone2026

# Secret used to sign the admin session cookie. Change it before going live.
ADMIN_SECRET=myphone-console-secret-2026

# Public URL of the storefront, used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://myphone.ly

# Optional: size of the PostgreSQL connection pool (default 5).
DATABASE_POOL_MAX=5
